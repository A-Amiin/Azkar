# Copy to .env.local for local development and fill in real values.
# In production (Vercel), set these under Project Settings → Environment
# Variables — never commit real values to this repo.
# See NOTIFICATIONS_PLAN.md section 14 for what each one is and why.

# Public: read by the OneSignal Web SDK in the browser. Not a secret — the
# App ID only scopes the client SDK to this OneSignal app.
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Secret — server-only. Used exclusively inside app/api/* Route Handlers to
# call the OneSignal REST API. Never prefix with NEXT_PUBLIC_.
ONESIGNAL_REST_API_KEY=

# Secret — server-only. Vercel automatically sends this as the
# `Authorization: Bearer <value>` header on every Cron-triggered request;
# the Cron Route Handlers compare it to reject any other caller. Generate
# with a password generator (16+ random characters).
CRON_SECRET=
